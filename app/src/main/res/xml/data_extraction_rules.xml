<?xml version="1.0" encoding="utf-8"?>
<!-- Stellar Disc keeps everything on your phone: nothing goes to cloud backups or phone-to-phone
     transfers made by Android. Use the app's own backup (Settings → Backup) instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
